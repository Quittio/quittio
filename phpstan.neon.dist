includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon

parameters:
    level: max
    paths:
        - packages/core/src
        - packages/country-de/src
        - packages/laravel/src
        - tools/validate-fixtures.php
        - tools/docs/generate.php
        - tools/codelists/update.php
    tmpDir: .phpstan.cache
    treatPhpDocTypesAsCertain: false
    strictRules:
        # Larastan forwards Eloquent builder calls through static @method tags,
        # which this rule would report for every query.
        dynamicCallOnStaticMethod: false
