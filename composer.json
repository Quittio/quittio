{
    "name": "quittio/quittio",
    "description": "E-invoicing for Laravel: create, validate, read and render EN 16931 invoices (ZUGFeRD/Factur-X, XRechnung, UBL, Peppol BIS), with the country pack for Germany.",
    "keywords": [
        "laravel",
        "e-invoice",
        "einvoice",
        "zugferd",
        "factur-x",
        "xrechnung",
        "peppol",
        "en16931",
        "invoice"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://docs.quittio.dev",
    "support": {
        "issues": "https://github.com/Quittio/quittio/issues",
        "source": "https://github.com/Quittio/quittio",
        "docs": "https://docs.quittio.dev"
    },
    "authors": [
        {
            "name": "Niklas Forst"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-ctype": "*",
        "ext-dom": "*",
        "ext-gd": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-xmlwriter": "*",
        "ext-zlib": "*",
        "brick/math": "^1.0",
        "brick/money": "^0.15.2",
        "laravel/framework": "^13.0",
        "league/commonmark": "^2.6",
        "mpdf/mpdf": "^8.3.1",
        "mpdf/qrcode": "^1.2.2",
        "nesbot/carbon": "^3.8",
        "psr/log": "^3.0",
        "setasign/fpdi": "^2.6"
    },
    "require-dev": {
        "larastan/larastan": "^3.12",
        "laravel/pint": "^1.20",
        "opis/json-schema": "^2.6",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.7 || ^5.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0",
        "spatie/pest-plugin-snapshots": "^2.2"
    },
    "suggest": {
        "ext-intl": "Locale-aware number and date formatting",
        "ext-zip": "Unpack the KoSIT validator configuration (quittio:schemas:download)",
        "opis/json-schema": "Validate JSON input against the shipped invoice schema"
    },
    "replace": {
        "quittio/core": "self.version",
        "quittio/laravel": "self.version",
        "quittio/country-de": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Quittio\\Core\\": "packages/core/src/",
            "Quittio\\Laravel\\": "packages/laravel/src/Laravel/",
            "Quittio\\Country\\DE\\": "packages/country-de/src/"
        },
        "files": [
            "packages/country-de/bootstrap.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Quittio\\Core\\Tests\\": "packages/core/tests/",
            "Quittio\\Tests\\": "packages/laravel/tests/",
            "Quittio\\Country\\DE\\Tests\\": "packages/country-de/tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Quittio\\Laravel\\QuittioServiceProvider",
                "Quittio\\Country\\DE\\Laravel\\GermanyServiceProvider"
            ],
            "aliases": {
                "Quittio": "Quittio\\Laravel\\Facades\\Quittio"
            }
        },
        "quittio": {
            "country-packs": [
                "Quittio\\Country\\DE\\CountryDE"
            ]
        },
        "branch-alias": {
            "dev-master": "0.1.x-dev"
        }
    },
    "scripts": {
        "test": "pest",
        "test:core": "pest --testsuite=core",
        "test:laravel": "pest --testsuite=laravel",
        "test:country-de": "pest --testsuite=country-de",
        "analyse": "phpstan analyse --memory-limit=1G",
        "lint": "pint --test",
        "format": "pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
