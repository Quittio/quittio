{
    "name": "quittio/quittio",
    "description": "E-invoicing for PHP and Laravel: create, validate, read and render EN 16931 invoices (ZUGFeRD/Factur-X, XRechnung, UBL, Peppol BIS). Bundles the core, the Laravel integration and the country pack for Germany; without Laravel use quittio/core and quittio/country-de.",
    "keywords": [
        "php",
        "laravel",
        "e-invoice",
        "einvoice",
        "zugferd",
        "factur-x",
        "xrechnung",
        "peppol",
        "en16931",
        "invoice"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://docs.quittio.dev",
    "support": {
        "issues": "https://github.com/Quittio/quittio/issues",
        "source": "https://github.com/Quittio/quittio",
        "docs": "https://docs.quittio.dev"
    },
    "authors": [
        {
            "name": "Niklas Forst"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-ctype": "*",
        "ext-dom": "*",
        "ext-gd": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-xmlwriter": "*",
        "ext-zlib": "*",
        "brick/math": "^1.0",
        "brick/money": "^0.15.2",
        "laravel/framework": "^13.0",
        "league/commonmark": "^2.6",
        "mpdf/mpdf": "^8.3.1",
        "mpdf/qrcode": "^1.2.2",
        "nesbot/carbon": "^3.8",
        "psr/log": "^3.0",
        "setasign/fpdi": "^2.6"
    },
    "require-dev": {
        "larastan/larastan": "^3.12",
        "laravel/pint": "^1.20",
        "opis/json-schema": "^2.6",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.7 || ^5.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "spatie/pest-plugin-snapshots": "^2.2"
    },
    "suggest": {
        "ext-intl": "Locale-aware number and date formatting",
        "ext-zip": "Unpack the KoSIT validator configuration (quittio:schemas:download)",
        "opis/json-schema": "Validate JSON input against the shipped invoice schema"
    },
    "replace": {
        "quittio/core": "self.version",
        "quittio/laravel": "self.version",
        "quittio/country-de": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Quittio\\Core\\": "packages/core/src/",
            "Quittio\\Laravel\\": "packages/laravel/src/Laravel/",
            "Quittio\\Country\\DE\\": "packages/country-de/src/"
        },
        "files": [
            "packages/country-de/bootstrap.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Quittio\\Core\\Tests\\": "packages/core/tests/",
            "Quittio\\Tests\\": "packages/laravel/tests/",
            "Quittio\\Country\\DE\\Tests\\": "packages/country-de/tests/",
            "Quittio\\Country\\AT\\": "packages/country-at/src/",
            "Quittio\\Country\\AT\\Tests\\": "packages/country-at/tests/",
            "Quittio\\Country\\CH\\": "packages/country-ch/src/",
            "Quittio\\Country\\CH\\Tests\\": "packages/country-ch/tests/",
            "Quittio\\Country\\BE\\": "packages/country-be/src/",
            "Quittio\\Country\\BE\\Tests\\": "packages/country-be/tests/",
            "Quittio\\Country\\FR\\": "packages/country-fr/src/",
            "Quittio\\Country\\FR\\Tests\\": "packages/country-fr/tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Quittio\\Laravel\\QuittioServiceProvider",
                "Quittio\\Country\\DE\\Laravel\\GermanyServiceProvider"
            ],
            "aliases": {
                "Quittio": "Quittio\\Laravel\\Facades\\Quittio"
            }
        },
        "quittio": {
            "country-packs": [
                "Quittio\\Country\\DE\\CountryDE"
            ]
        },
        "branch-alias": {
            "dev-master": "0.7.x-dev"
        }
    },
    "scripts": {
        "test": "pest",
        "test:core": "pest --testsuite=core",
        "test:laravel": "pest --testsuite=laravel",
        "test:country-de": "pest --testsuite=country-de",
        "test:fast": "pest --parallel --exclude-group=official,visual",
        "test:official": [
            "Composer\\Config::disableProcessTimeout",
            "tools/schemas/download.sh",
            "tools/fixtures/download.sh",
            "pest --group=official"
        ],
        "test:visual": [
            "Composer\\Config::disableProcessTimeout",
            "pest --group=visual"
        ],
        "test:coverage": [
            "Composer\\Config::disableProcessTimeout",
            "pest --parallel --exclude-group=official,visual --coverage --coverage-clover=build/coverage/clover.xml"
        ],
        "test:mutation": [
            "Composer\\Config::disableProcessTimeout",
            "pest -c phpunit.mutation.xml --mutate --everything --parallel --exclude-group=official,visual --path=packages/core/src/Calculation,packages/core/src/Validation/Rules,packages/core/src/Xml,packages/core/src/Reading,packages/country-de/src/Rules --min=85"
        ],
        "analyse": "phpstan analyse --memory-limit=1G",
        "lint": "pint --test",
        "format": "pint",
        "docs:generate": "php tools/docs/generate.php",
        "codelists:update": "php tools/codelists/update.php",
        "ci": [
            "Composer\\Config::disableProcessTimeout",
            "@lint",
            "@analyse",
            "@test:fast"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts-descriptions": {
        "test:fast": "The tests the CI matrix runs: without the official validators and the visual comparison",
        "test:official": "Downloads the official validators and the XRechnung test suite, then runs the tests that need them (Java)",
        "test:visual": "Compares the rendered sample invoices with the baselines (poppler)",
        "test:coverage": "Line coverage with pcov or Xdebug, written to build/coverage/clover.xml",
        "test:mutation": "Mutation testing of the calculator, the rules and the XML code (pcov or Xdebug)",
        "docs:generate": "Regenerates the JSON schema and docs/field-reference.md from the data model",
        "codelists:update": "Regenerates the code lists from the EN 16931 Schematron (after tools/schemas/download.sh)",
        "ci": "Lint, static analysis and the fast tests, as CI runs them"
    }
}
