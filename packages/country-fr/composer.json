{
    "name": "quittio/country-fr",
    "description": "Quittio country pack for France: Factur-X for domestic business invoices, the mentions of the e-invoicing reform of September 2026, VAT presets and invoice mentions (CGI, Code de commerce), SIREN, late payment penalties. Not reviewed by a tax adviser yet.",
    "keywords": [
        "php",
        "e-invoice",
        "e-invoicing",
        "factur-x",
        "facture-electronique",
        "facturation-electronique",
        "tva",
        "siren",
        "france"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://quittio.dev",
    "support": {
        "issues": "https://github.com/Quittio/quittio/issues",
        "source": "https://github.com/Quittio/quittio",
        "docs": "https://quittio.dev/docs"
    },
    "authors": [
        {
            "name": "Niklas Forst"
        }
    ],
    "require": {
        "php": "^8.3",
        "brick/math": "^1.0",
        "brick/money": "^0.15.2",
        "quittio/core": "self.version"
    },
    "require-dev": {
        "pestphp/pest": "^4.7 || ^5.0"
    },
    "autoload": {
        "psr-4": {
            "Quittio\\Country\\FR\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Quittio\\Country\\FR\\Tests\\": "tests/"
        }
    },
    "extra": {
        "quittio": {
            "country-packs": [
                "Quittio\\Country\\FR\\CountryFR"
            ]
        },
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        }
    },
    "minimum-stability": "stable",
    "scripts": {
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
