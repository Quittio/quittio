{
    "name": "quittio/laravel",
    "description": "Laravel integration for Quittio e-invoicing: facade, configuration, Blade templates, commands and testing helpers.",
    "keywords": [
        "laravel",
        "e-invoice",
        "zugferd",
        "factur-x",
        "xrechnung",
        "peppol"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://quittio.github.io/quittio/",
    "support": {
        "issues": "https://github.com/Quittio/quittio/issues",
        "source": "https://github.com/Quittio/quittio",
        "docs": "https://quittio.github.io/quittio/"
    },
    "authors": [
        {
            "name": "Niklas Forst"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0",
        "psr/log": "^3.0",
        "quittio/core": "self.version"
    },
    "suggest": {
        "ext-zip": "Unpack the validator configuration in quittio:schemas:download",
        "quittio/country-de": "Country pack for Germany (UStG, XRechnung, DIN 5008)"
    },
    "autoload": {
        "psr-4": {
            "Quittio\\Laravel\\": "src/Laravel/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Quittio\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Quittio\\Laravel\\QuittioServiceProvider"
            ],
            "aliases": {
                "Quittio": "Quittio\\Laravel\\Facades\\Quittio"
            }
        },
        "branch-alias": {
            "dev-master": "0.1.x-dev"
        }
    },
    "minimum-stability": "stable"
}
