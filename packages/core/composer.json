{
    "name": "quittio/core",
    "description": "Country-neutral e-invoicing core: EN 16931 data model, calculation, validation, CII/UBL, ZUGFeRD/Factur-X PDF/A-3.",
    "keywords": [
        "e-invoice",
        "einvoice",
        "en16931",
        "zugferd",
        "factur-x",
        "xrechnung",
        "ubl",
        "cii",
        "peppol",
        "pdfa"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://docs.quittio.dev",
    "support": {
        "issues": "https://github.com/Quittio/quittio/issues",
        "source": "https://github.com/Quittio/quittio",
        "docs": "https://docs.quittio.dev"
    },
    "authors": [
        {
            "name": "Niklas Forst"
        }
    ],
    "require": {
        "ext-ctype": "*",
        "ext-dom": "*",
        "ext-gd": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-xmlwriter": "*",
        "ext-zlib": "*",
        "php": "^8.3",
        "brick/math": "^1.0",
        "brick/money": "^0.15.2",
        "league/commonmark": "^2.6",
        "mpdf/mpdf": "^8.3.1",
        "mpdf/qrcode": "^1.2.2",
        "nesbot/carbon": "^3.8",
        "psr/log": "^3.0",
        "setasign/fpdi": "^2.6"
    },
    "require-dev": {
        "opis/json-schema": "^2.6",
        "pestphp/pest": "^4.7 || ^5.0",
        "quittio/country-de": "self.version",
        "spatie/pest-plugin-snapshots": "^2.2"
    },
    "suggest": {
        "ext-intl": "Locale-aware number and date formatting",
        "ext-zip": "Unpack the KoSIT validator configuration (quittio:schemas:download)",
        "opis/json-schema": "Validate JSON input against the shipped invoice schema",
        "quittio/laravel": "Laravel integration with Blade templates, facade, commands and testing helpers",
        "quittio/country-de": "Country pack for Germany (UStG, XRechnung, DIN 5008)"
    },
    "autoload": {
        "psr-4": {
            "Quittio\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Quittio\\Core\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "extra": {
        "branch-alias": {
            "dev-master": "0.3.x-dev"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
