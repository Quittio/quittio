{
    "name": "quittio/country-at",
    "description": "Quittio country pack for Austria: e-invoices (e-Rechnung) in ebInterface 6.1 and with the CIUS-AT-NAT and CIUS-AT-GOV profiles, UStG mandatory fields, tax presets, default interest under the UGB. Not reviewed by a tax adviser yet.",
    "keywords": [
        "php",
        "e-invoice",
        "e-invoicing",
        "e-rechnung",
        "ebinterface",
        "cius-at",
        "en16931",
        "ustg",
        "austria"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://quittio.dev",
    "support": {
        "issues": "https://github.com/Quittio/quittio/issues",
        "source": "https://github.com/Quittio/quittio",
        "docs": "https://quittio.dev/docs"
    },
    "authors": [
        {
            "name": "Niklas Forst"
        }
    ],
    "require": {
        "php": "^8.3",
        "brick/math": "^1.0",
        "brick/money": "^0.15.2",
        "quittio/core": "self.version"
    },
    "require-dev": {
        "pestphp/pest": "^4.7 || ^5.0"
    },
    "autoload": {
        "psr-4": {
            "Quittio\\Country\\AT\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Quittio\\Country\\AT\\Tests\\": "tests/"
        }
    },
    "extra": {
        "quittio": {
            "country-packs": [
                "Quittio\\Country\\AT\\CountryAT"
            ]
        },
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        }
    },
    "minimum-stability": "stable",
    "scripts": {
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
