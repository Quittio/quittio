{
    "name": "quittio/country-ch",
    "description": "Quittio country pack for Switzerland: VAT presets and invoice requirements of the MWSTG, Swiss QR bill with payment part, 5 Rappen rounding.",
    "keywords": [
        "php",
        "e-invoice",
        "qr-bill",
        "qr-rechnung",
        "mwst",
        "switzerland"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://quittio.dev",
    "support": {
        "issues": "https://github.com/Quittio/quittio/issues",
        "source": "https://github.com/Quittio/quittio",
        "docs": "https://quittio.dev/docs"
    },
    "authors": [
        {
            "name": "Niklas Forst"
        }
    ],
    "require": {
        "php": "^8.3",
        "brick/math": "^1.0",
        "brick/money": "^0.15.2",
        "quittio/core": "self.version"
    },
    "require-dev": {
        "pestphp/pest": "^4.7 || ^5.0"
    },
    "autoload": {
        "psr-4": {
            "Quittio\\Country\\CH\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Quittio\\Country\\CH\\Tests\\": "tests/"
        }
    },
    "extra": {
        "quittio": {
            "country-packs": [
                "Quittio\\Country\\CH\\CountryCH"
            ]
        },
        "branch-alias": {
            "dev-master": "0.8.x-dev"
        }
    },
    "minimum-stability": "stable",
    "scripts": {
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
