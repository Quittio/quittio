{
    "name": "quittio/country-de",
    "description": "Quittio country pack for Germany: UStG mandatory fields, tax presets, XRechnung profiles and BR-DE rules, DIN 5008 layouts.",
    "keywords": [
        "e-invoice",
        "xrechnung",
        "zugferd",
        "ustg",
        "germany",
        "din5008"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://docs.quittio.dev",
    "support": {
        "issues": "https://github.com/Quittio/quittio/issues",
        "source": "https://github.com/Quittio/quittio",
        "docs": "https://docs.quittio.dev"
    },
    "authors": [
        {
            "name": "Niklas Forst"
        }
    ],
    "require": {
        "ext-ctype": "*",
        "php": "^8.3",
        "brick/math": "^1.0",
        "brick/money": "^0.15.2",
        "quittio/core": "self.version"
    },
    "require-dev": {
        "pestphp/pest": "^4.7 || ^5.0"
    },
    "autoload": {
        "psr-4": {
            "Quittio\\Country\\DE\\": "src/"
        },
        "files": [
            "bootstrap.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Quittio\\Country\\DE\\Tests\\": "tests/"
        }
    },
    "extra": {
        "quittio": {
            "country-packs": [
                "Quittio\\Country\\DE\\CountryDE"
            ]
        },
        "laravel": {
            "providers": [
                "Quittio\\Country\\DE\\Laravel\\GermanyServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-master": "0.2.x-dev"
        }
    },
    "minimum-stability": "stable",
    "suggest": {
        "laravel/framework": "Base rate configuration and php artisan quittio:base-rate:update"
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
