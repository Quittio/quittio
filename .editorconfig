root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

# GitHub workflows, Dependabot, testbench.yaml and docs/nav.yml.
[*.{yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Third-party schemas, font licences and test fixtures are kept byte for byte as published or
# as received.
[{packages/core/resources/xsd/**,packages/core/resources/fonts/**,packages/*/tests/Fixtures/**}]
charset = unset
end_of_line = unset
indent_size = unset
indent_style = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
