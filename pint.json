{
    "preset": "laravel",
    "rules": {
        "declare_strict_types": true,
        "final_class": false,
        "fully_qualified_strict_types": true,
        "global_namespace_import": {
            "import_classes": true,
            "import_constants": false,
            "import_functions": false
        },
        "phpdoc_align": false
    },
    "exclude": [
        "packages/core/resources",
        "packages/laravel/resources/views"
    ]
}
